# Backend: copy these values to server/.env and fill in your credentials.
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=
CLERK_SECRET_KEY=
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free
EMBEDDING_DIMENSIONS=2048
OPENROUTER_CHAT_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free

# Frontend: copy these values to client/.env.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:5000